# syntax=docker/dockerfile:1.7
# blockpose ROS 2 image — extends the core image with ROS 2 Jazzy.
# Needed only for: the ros2/ wrapper package (Phase 6), bag export from
# legacy .db3 / custom messages, and live integration tests.
#
# Build the core image first:
#   docker build -f docker/Dockerfile.core -t blockpose-core .
#   docker build -f docker/Dockerfile.ros2 -t blockpose-ros2 .

FROM blockpose-core

USER root
ARG DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# ROS 2 Jazzy (Ubuntu 24.04 / Noble pairing)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common gnupg lsb-release \
    && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-base \
        ros-dev-tools \
        python3-colcon-common-extensions \
        python3-rosdep \
        # bag tooling — MCAP storage plugin + converter
        ros-jazzy-rosbag2 \
        ros-jazzy-rosbag2-storage-mcap \
        # message packages the wrapper converts from/to
        ros-jazzy-sensor-msgs \
        ros-jazzy-geometry-msgs \
        ros-jazzy-tf2-ros \
        ros-jazzy-tf2-eigen \
        ros-jazzy-visualization-msgs \
    && rm -rf /var/lib/apt/lists/* \
    && rosdep init || true

USER ubuntu
RUN rosdep update

# Source ROS in interactive shells. Deliberately NOT in ENV/ENTRYPOINT:
# plain-CMake core builds inside this image must still work unsourced,
# proving the core has no hidden ROS dependency.
RUN echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc

WORKDIR /workspace
CMD ["/bin/bash"]
