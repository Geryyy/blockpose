# syntax=docker/dockerfile:1.7
# blockpose core development image — Python/Open3D prototyping.

ARG UV_VERSION=0.5.24
ARG NODE_MAJOR=24
ARG OPENCLAUDE_VERSION=0.24.0

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_MAJOR
ARG OPENCLAUDE_VERSION

# ---------------------------------------------------------------------------
# System packages: Python + GUI/X11 runtime libs for Open3D's visualizer
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        git-lfs \
        curl \
        ca-certificates \
        gnupg \
        python3 \
        python3-dev \
        python3-venv \
        # runtime deps of Open3D's GUI/X11 visualization tools
        libdbus-1-3 \
        libegl1 \
        libglib2.0-0 \
        libgl1 \
        libgl1-mesa-dri \
        libglx-mesa0 \
        libglu1-mesa-dev \
        libgomp1 \
        libice6 \
        libjpeg-turbo8 \
        libpng16-16 \
        libsm6 \
        libx11-6 \
        libwayland-cursor0 \
        libxcb-cursor0 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxinerama1 \
        libxkbcommon-x11-0 \
        libxrandr2 \
        libxrender1 \
        # convenience
        less \
        jq \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# uv — Python environment manager (venv + lockfile inside the container)
# ---------------------------------------------------------------------------
COPY --from=uv /uv /uvx /usr/local/bin/

# ---------------------------------------------------------------------------
# Node.js + OpenClaude CLI
# ---------------------------------------------------------------------------
RUN install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && chmod 0644 /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g "@gitlawb/openclaude@${OPENCLAUDE_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# Ensure Git LFS is initialized for both root during build and the dev user.
RUN git lfs install --system

# Ubuntu 24.04 ships a non-root 'ubuntu' user (uid 1000) — use it so files
# created in mounted volumes belong to the host user.
USER ubuntu
WORKDIR /workspace

# uv keeps its venv in-project (.venv) so it survives via the repo mount.
ENV UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PATH=/workspace/.venv/bin:$PATH

RUN printf '\nif [ -f /workspace/.venv/bin/activate ]; then\n    source /workspace/.venv/bin/activate\nfi\n' >> ~/.bashrc

CMD ["/bin/bash"]
