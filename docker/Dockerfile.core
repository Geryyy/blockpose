# syntax=docker/dockerfile:1.7
# blockpose development image:
# - DINOv2 backbone + trainable MLP head
# - SAM 2 / Grounded-SAM-2 dataset preparation
# - Open3D visualization
# - CUDA-enabled PyTorch development

ARG UV_VERSION=0.12.0

ARG CUDA_VERSION=12.8.1
ARG UBUNTU_VERSION=24.04

ARG PYTHON_VERSION=3.12

ARG TORCH_VERSION=2.10.0
ARG TORCHVISION_VERSION=0.25.0
ARG TORCH_CUDA_INDEX=cu128

ARG NODE_MAJOR=24
ARG OPENCLAUDE_VERSION=0.24.0

# ---------------------------------------------------------------------------
# uv binary
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# ---------------------------------------------------------------------------
# CUDA development image
#
# "devel" is required because:
# - Grounding DINO compiles CUDA deformable-attention operators
# - SAM 2 can compile a CUDA extension
# ---------------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive

ARG PYTHON_VERSION
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TORCH_CUDA_INDEX

ARG NODE_MAJOR
ARG OPENCLAUDE_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ---------------------------------------------------------------------------
# CUDA and Python environment
# ---------------------------------------------------------------------------
ENV CUDA_HOME=/usr/local/cuda \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    CUDA_MODULE_LOADING=LAZY \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_CACHE_DIR=/opt/uv/cache \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    UV_HTTP_TIMEOUT=600 \
    UV_HTTP_CONNECT_TIMEOUT=60 \
    UV_HTTP_RETRIES=10 \
    UV_CONCURRENT_DOWNLOADS=4

ENV PATH="${VIRTUAL_ENV}/bin:${CUDA_HOME}/bin:${PATH}"

# Model weights (SAM2 via Hugging Face, anything via torch.hub) go to a fixed
# path rather than $HOME/.cache, so docker-compose can mount one named volume
# over it and a `docker compose run --rm` stops re-downloading them every time.
ENV HF_HOME=/opt/model-cache/huggingface \
    TORCH_HOME=/opt/model-cache/torch

# ---------------------------------------------------------------------------
# System packages
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
  # development toolchain for SAM 2 / Grounding DINO extensions
  build-essential \
  cmake \
  ninja-build \
  pkg-config \
  \
  # general development
  git \
  git-lfs \
  curl \
  wget \
  ca-certificates \
  gnupg \
  sudo \
  python3 \
  \
  # image/video dataset preparation
  ffmpeg \
  \
  # blockpose_core (cpp/) build dependencies
  #
  # libeigen3-dev provides the CMake package cpp/CMakeLists.txt requires
  # unconditionally -- find_package(Eigen3 3.3 REQUIRED NO_MODULE) fails the
  # configure step for every build of the core, with or without Python or
  # vision, when it is absent. That in turn means tools/check_cpp_consumer.sh
  # (the pre-ship gate for the ROS-facing surface) cannot run at all, and the
  # gitignored python/blockpose/_core*.so cannot be rebuilt from a clean
  # clone. This package is header-only (no .so to link at runtime), so unlike
  # libopencv-dev below there is no separate "pip package doesn't provide the
  # system lib" failure mode to guard against -- just the missing headers.
  libeigen3-dev \
  # libgtest-dev provides the CMake package cpp/CMakeLists.txt's
  # find_package(GTest REQUIRED) needs, which cpp/'s unit tests (built when
  # -DBLOCKPOSE_CORE_BUILD_TESTING=ON is passed explicitly; OFF by default)
  # link against -- the `ctest` workflow README.md documents under "Portable
  # C++ core" passes this flag and needs this to configure at all.
  # tools/check_cpp_consumer.sh deliberately builds with testing OFF and does
  # not need this package (see that script's own comment), so this is about
  # being able to run the unit tests locally, not about the ship-check gate.
  libgtest-dev \
  \
  # Open3D / OpenCV / X11 / OpenGL runtime
  #
  # libopencv-dev (not just pip's opencv-python) is required: the compiled
  # blockpose._core nanobind extension links against the SYSTEM
  # libopencv_{core,imgproc,calib3d}.so at import time, which opencv-python's
  # bundled, privately-namespaced runtime does not provide. Without this,
  # `import blockpose._core` fails with a bare "libopencv_calib3d.so.406:
  # cannot open shared object file" -- see models/production/README.md.
  # It is also what cpp/CMakeLists.txt's optional blockpose::vision target
  # (BLOCKPOSE_VISION_BUILD, find_package(OpenCV COMPONENTS core imgproc
  # calib3d)) needs to build at all -- without it, that target is silently
  # skipped ("OpenCV not found: blockpose::vision will not be built") rather
  # than failing the configure, which made the gap easy to miss.
  libopencv-dev \
  libdbus-1-3 \
  libegl1 \
  libglib2.0-0 \
  libgl1 \
  libgl1-mesa-dri \
  libglx-mesa0 \
  libglu1-mesa-dev \
  libgomp1 \
  libice6 \
  libjpeg-turbo8 \
  libpng16-16 \
  libsm6 \
  libvulkan1 \
  libwayland-cursor0 \
  libx11-6 \
  libxext6 \
  libxfixes3 \
  libxi6 \
  libxinerama1 \
  libxkbcommon-x11-0 \
  libxrandr2 \
  libxrender1 \
  libxcb-cursor0 \
  mesa-utils \
  xauth \
  \
  # convenience
  bash-completion \
  less \
  jq \
  nano \
  rsync \
  unzip \
  xz-utils \
  && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# uv
# ---------------------------------------------------------------------------
COPY --from=uv /uv /uvx /usr/local/bin/

# ---------------------------------------------------------------------------
# Python 3.12 + base ML environment
#
# The environment lives outside /workspace so it is not hidden when the
# repository is mounted into /workspace by VS Code.
# ---------------------------------------------------------------------------
RUN --mount=type=cache,target=/opt/uv/cache,sharing=locked \
    uv python install "${PYTHON_VERSION}" \
  && uv venv --python "${PYTHON_VERSION}" "${VIRTUAL_ENV}" \
  \
  # Official CUDA-enabled PyTorch wheels
  && uv pip install \
  --python "${VIRTUAL_ENV}/bin/python" \
  "torch==${TORCH_VERSION}" \
  "torchvision==${TORCHVISION_VERSION}" \
  --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}" \
  \
  # Computer vision / training / dataset tooling
  && uv pip install \
  --python "${VIRTUAL_ENV}/bin/python" \
  "setuptools>=69,<76" \
  wheel \
  "numpy>=1.26,<2.0" \
  scipy \
  pandas \
  pillow \
  opencv-python \
  open3d \
  matplotlib \
  tqdm \
  pyyaml \
  scikit-learn \
  tensorboard \
  torchmetrics \
  timm \
  einops \
  omegaconf \
  hydra-core \
  fvcore \
  iopath \
  submitit \
  accelerate \
  safetensors \
  huggingface-hub \
  "transformers>=4.57" \
  supervision \
  pycocotools \
  av \
  addict \
  yapf \
  termcolor \
  ipykernel \
  nvitop

# transformers>=4.57 is required for the native Sam2Model/Sam2Processor
# classes used by blockpose.rgb_annotation.TransformersSam2Backend (the SAM2
# point-prompt annotation assist actually wired into the repo). This is newer
# than Grounded-SAM-2's current Hugging Face demo supports (<4.55); Grounded-
# SAM-2 isn't integrated anywhere in-repo yet, so that compatibility is
# deferred until it actually is.

# ---------------------------------------------------------------------------
# Node.js + OpenClaude CLI
# ---------------------------------------------------------------------------
RUN install -d -m 0755 /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
  | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && chmod 0644 /etc/apt/keyrings/nodesource.gpg \
  && echo \
  "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
  > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && npm install -g "@gitlawb/openclaude@${OPENCLAUDE_VERSION}" \
  && npm cache clean --force \
  && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Git LFS and development user
#
# Ubuntu 24.04 normally already contains the uid-1000 "ubuntu" user.
# ---------------------------------------------------------------------------
RUN git lfs install --system \
  && if ! id -u ubuntu >/dev/null 2>&1; then \
  groupadd --gid 1000 ubuntu \
  && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ubuntu; \
  fi \
  && usermod --shell /bin/bash ubuntu \
  && echo "ubuntu ALL=(root) NOPASSWD:ALL" \
  > /etc/sudoers.d/ubuntu \
  && chmod 0440 /etc/sudoers.d/ubuntu \
  && mkdir -p /opt/model-cache/huggingface /opt/model-cache/torch \
  && chown -R ubuntu:ubuntu /opt/venv /opt/uv /opt/model-cache

# Verify that the installed Torch build contains CUDA support.
# A GPU is not visible during docker build, so torch.cuda.is_available()
# will normally still be false here.
RUN python -c \
  "import torch; print('Torch:', torch.__version__); print('Torch CUDA:', torch.version.cuda); assert torch.version.cuda is not None"

USER ubuntu
WORKDIR /workspace

RUN printf '\n# Python environment supplied by the development image\n' >> ~/.bashrc \
  && printf 'export VIRTUAL_ENV=/opt/venv\n' >> ~/.bashrc \
  && printf 'export PATH=/opt/venv/bin:$PATH\n' >> ~/.bashrc

CMD ["/bin/bash"]
