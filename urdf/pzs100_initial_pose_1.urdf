      <inertia ixx="1675.5160819145565" ixy="0" ixz="0" iyy="1675.5160819145565" iyz="0" izz="1675.5160819145565"/>
    </inertial>
  </link>
  <joint name="truck_pitch" type="revolute">
    <parent link="truck_origin"/>
    <child link="truck_rotated_pitch"/>
    <!-- be careful, there must not be any collision with the ground -->
    <origin rpy="0 -0.0 0" xyz="0 0 0.0"/>
    <limit effort="1e10" lower="-0.1" upper="0.1" velocity="0.1"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="1e8" friction="1e8"/>
  </joint>
  <!-- URDF does not have a revolute2 joint, using two revolute joints with a fake link instead -->
  <link name="truck_rotated_pitch">
    <inertial>
      <mass value="4188.790204786391"/>
      <inertia ixx="1675.5160819145565" ixy="0" ixz="0" iyy="1675.5160819145565" iyz="0" izz="1675.5160819145565"/>
    </inertial>
  </link>
  <joint name="truck_roll" type="revolute">
    <parent link="truck_rotated_pitch"/>
    <child link="truck_rotated_roll"/>
    <!-- be careful, there must not be any collision with the ground -->
    <origin rpy="-0.0 0 0" xyz="0 0 0"/>
    <limit effort="1e10" lower="-0.1" upper="0.1" velocity="0.1"/>
    <axis xyz="-1 0 0"/>
    <dynamics damping="1e8" friction="1e8"/>
  </joint>
  <link name="truck_rotated_roll">
    <inertial>
      <mass value="4188.790204786391"/>
