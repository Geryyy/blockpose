  <!-- Used for fixing robot to Gazebo 'base_link' -->
  <!-- https://classic.gazebosim.org/tutorials?tut=ros_urdf#RigidlyFixingAModeltotheWorld -->
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
