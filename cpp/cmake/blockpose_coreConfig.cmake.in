@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.3 NO_MODULE)
if(@BLOCKPOSE_VISION_ENABLED@)
  find_dependency(OpenCV COMPONENTS core imgproc calib3d)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/blockpose_coreTargets.cmake")
if(NOT TARGET blockpose::core)
  add_library(blockpose::core ALIAS blockpose::blockpose_core)
endif()
