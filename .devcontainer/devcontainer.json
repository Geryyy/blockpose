{
  "name": "blockpose-core",
  "build": {
    "dockerfile": "../docker/Dockerfile.core",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=${localWorkspaceFolder}/data,target=/data,type=bind,consistency=cached",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "BLOCKPOSE_DATASET": "/data",
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1"
  },
  "remoteUser": "ubuntu",
  "postCreateCommand": "uv sync --all-extras && cmake --preset dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "charliermarsh.ruff",
        "llvm-vs-code-extensions.vscode-clangd"
      ],
      "settings": {
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "workbench.colorTheme": "Monokai Dimmed"
      }
    }
  },
  // Rerun can run on the HOST (rerun --serve or native app); the container can
  // also open X11 GUI tools through the mounted display socket.
  // Forward the default gRPC port both ways.
  "forwardPorts": [9876],
  "runArgs": ["--network=host"]
}
