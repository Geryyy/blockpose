{
  "name": "blockpose-core",
  "build": {
    "dockerfile": "../docker/Dockerfile.core",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=${localWorkspaceFolder}/data,target=/data,type=bind,consistency=cached",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "BLOCKPOSE_DATASET": "/data",
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1",
    "XDG_SESSION_TYPE": "x11",
    "GDK_BACKEND": "x11",
    "QT_QPA_PLATFORM": "xcb",
    "GLFW_PLATFORM": "x11",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "remoteUser": "ubuntu",
  "postCreateCommand": "uv sync --all-extras",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "workbench.colorTheme": "Monokai Dimmed"
      }
    }
  },
  // Rerun can run on the HOST (rerun --serve or native app); the container can
  // also open X11 GUI tools through the mounted display socket.
  // Forward the default gRPC port both ways.
  "forwardPorts": [9876, 8888],
  "runArgs": ["--network=host", "--ipc=host"]
}
