<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.4">
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-26.7141 9.65177 15.3963 0 0.508 -0.464001</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gravity>0.0 0.0 -9.81</gravity>

    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
        </solver>
      </ode>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <!--upper bound for max_step_size x real_time_update_rate-->
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- for real time sim set to 0 ... 100 = 10% of the realtime-->
    </physics>

    <include>
      <uri>model://seibersdorf_environment</uri>
      <pose>6 -10 0 0 0 0</pose>
    </include>

    <!-- Global light source -->
    <light name='light_y_positive' type='directional'>
      <pose>0 20 1 -1.57 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <light name='light_z_positive' type='directional'>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <light name='light_x_negative' type='directional'>
      <pose>-20 0 0 0 -1.57 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
    </light>

    <include>
      <uri>model://seibersdorf_office_container</uri>
      <pose>3.03 1.22 0.025 0 0 -1.57</pose>
      <is_static>true</is_static>
    </include>

  </world>
</sdf>
